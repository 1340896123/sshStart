yc.123756.xyz {
	@release path_regexp release ^/updates/(manifest\.jws|DesktopSharp-[0-9]+\.[0-9]+\.[0-9]+-win-x64-[a-f0-9]{64}-Setup\.exe)$
	handle @release {
		uri strip_prefix /updates
		root * /opt/desktop-sharp-e2e/.temp/updates
		@manifest path /updates/manifest.jws
		header @manifest Cache-Control "no-store"
		header @manifest Content-Type "application/jose"
		@installer path *.exe
		header @installer Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	respond 404
}

sshdw.123756.xyz {
	reverse_proxy 127.0.0.1:18787
}
