# Full Docker Hub image reference, for example:
# docker.io/your-dockerhub-username/sshstar-sync:latest
DOCKERHUB_IMAGE=docker.io/your-dockerhub-username/sshstar-sync:latest

# Generate a unique value and keep it outside source control.
SSHSTAR_SYNC_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Keep the service reachable only through a local reverse proxy by default.
SSHSTAR_SYNC_BIND_ADDRESS=127.0.0.1
SSHSTAR_SYNC_HOST_PORT=8787
SSHSTAR_SYNC_TRUST_PROXY=false
