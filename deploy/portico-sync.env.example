# Full Docker Hub image reference, for example:
# docker.io/your-dockerhub-username/portico-sync:latest
DOCKERHUB_IMAGE=docker.io/your-dockerhub-username/portico-sync:latest

# Generate a unique value and keep it outside source control.
PORTICO_SYNC_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Keep the service reachable only through a local reverse proxy by default.
PORTICO_SYNC_BIND_ADDRESS=127.0.0.1
PORTICO_SYNC_HOST_PORT=8787
PORTICO_SYNC_TRUST_PROXY=false
