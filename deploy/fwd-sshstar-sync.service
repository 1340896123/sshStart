[Unit]
Description=sshStar cloud sync service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sshstar-sync
Group=sshstar-sync
WorkingDirectory=/opt/sshstar-sync
EnvironmentFile=/etc/sshstar-sync.env
ExecStart=/usr/local/bin/node /opt/sshstar-sync/src/index.mjs
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sshstar-sync
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
